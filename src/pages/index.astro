  description="社員プロフィール、スキル、稼働状況、プロジェクト情報を一元管理。AIチャットでアサイン候補もすぐに見つかります。"
>
  <Header />
  <main>
    <Hero />
    <Problem />
    <Solution />
    <Features />
    <UseCases />
    <Security />
    <CtaSection />
  </main>
  <Footer />
</Layout>
