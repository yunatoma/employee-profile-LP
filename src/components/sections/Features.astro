---
const features = [
  {
    icon: 'fa-user',
    label: 'People Hub',
    color: 'text-cyan-600',
    tint: 'bg-cyan-50',
    title: 'プロフィール管理',
    description: '氏名・部署・職種・スキル・稼働状況・プロジェクト・資格・アバター画像など豊富な項目を管理。社員一覧はリスト/ギャラリー表示に切り替え可能。',
    imgSrc: '/screenshot-employee-list.png',
    alt: 'ひとナビ 社員一覧画面',
  },
  {
    icon: 'fa-chart-line',
    label: 'Analytics',
    color: 'text-indigo-600',
    tint: 'bg-indigo-50',
    title: 'ダッシュボード・可視化',
    description: '在籍社員数・稼働状況のサマリー、ステータス内訳グラフ、部署別社員数グラフ、スキル別人数TOP10グラフで組織全体を一目で把握。',
    imgSrc: '/screenshot-dashboard.png',
    alt: 'ひとナビ ダッシュボード画面',
  },
  {
    icon: 'fa-building',
    label: 'Organization',
    color: 'text-lime-700',
    tint: 'bg-lime-50',
    title: '組織管理・権限管理',
    description: 'Googleログインで即座に利用開始。組織単位でデータを分離し、管理者と一般社員の権限を分けてセキュアに運用できます。',
    imgSrc: null,
    alt: null,
  },
  {
    icon: 'fa-clipboard-list',
    label: 'Workflow',
    color: 'text-pink-600',
    tint: 'bg-pink-50',
    title: '申請管理',
    description: '社員が新しいスキルやプロジェクトを申請し、管理者が承認・却下。未処理の申請はヘッダーの通知ベルでリアルタイムに確認できます。',
    imgSrc: '/screenshot-requests.png',
    alt: 'ひとナビ 申請管理画面',
  },
  {
    icon: 'fa-robot',
    label: 'AI Search',
    color: 'text-violet-600',
    tint: 'bg-violet-50',
    title: 'AI人材検索',
    description: '全ページ共通のフローティングチャットUIから自然言語で質問。スキル検索、稼働状況確認、プロジェクトアサイン候補をAIが推薦します。',
    imgSrc: '/screenshot-ai-chat.png',
    alt: 'ひとナビ AIチャット画面',
  },
]
---

<section id="features" class="features-section relative overflow-hidden py-24 bg-sky-50/70">
  <div class="relative z-10 max-w-6xl mx-auto px-6">

    <div class="mb-16 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-cyan-600 font-semibold text-sm uppercase tracking-wider mb-3">Features</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">主要機能</h2>
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-semibold text-slate-600">
        <span class="rounded-full bg-white px-3 py-2 shadow-sm ring-1 ring-cyan-100">検索</span>
        <span class="rounded-full bg-white px-3 py-2 shadow-sm ring-1 ring-cyan-100">可視化</span>
        <span class="rounded-full bg-white px-3 py-2 shadow-sm ring-1 ring-cyan-100">申請</span>
        <span class="rounded-full bg-white px-3 py-2 shadow-sm ring-1 ring-cyan-100">AI</span>
      </div>
    </div>

    <div class="flex flex-col gap-10">
      {features.map((feature, i) => (
        <div class={`feature-panel grid gap-8 rounded-2xl border border-white bg-white/80 p-5 shadow-xl shadow-cyan-900/10 backdrop-blur-sm lg:grid-cols-[0.78fr_1.22fr] lg:p-8 ${i % 2 === 1 ? 'lg:grid-flow-col-dense' : ''}`}>
          <!-- テキスト -->
          <div class={`${i % 2 === 1 ? 'lg:col-start-2' : ''}`}>
            <div class="mb-5 flex items-center gap-3">
              <div class={`w-14 h-14 ${feature.tint} rounded-2xl flex items-center justify-center shadow-sm ring-1 ring-white`}>
                <i class={`fa-solid ${feature.icon} ${feature.color} text-2xl`}></i>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Feature {String(i + 1).padStart(2, '0')}</p>
                <p class={`text-sm font-semibold ${feature.color}`}>{feature.label}</p>
              </div>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
            <p class="text-gray-600 leading-relaxed text-lg">{feature.description}</p>
          </div>
          <!-- スクリーンショット -->
          <div class={`w-full ${i % 2 === 1 ? 'lg:col-start-1' : ''}`}>
            {feature.imgSrc ? (
              <div class="feature-window rounded-xl border border-slate-100 shadow-xl shadow-cyan-900/10 overflow-hidden bg-white">
                <div class="flex h-9 items-center gap-2 border-b border-slate-100 bg-slate-50 px-4">
                  <span class="h-2.5 w-2.5 rounded-full bg-pink-400"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-lime-400"></span>
                </div>
                <img src={feature.imgSrc} alt={feature.alt ?? ''} class="w-full h-auto" />
              </div>
            ) : feature.title === 'AI人材検索' ? (
              <div class="rounded-xl border border-cyan-100 shadow-lg shadow-cyan-900/10 overflow-hidden bg-white aspect-video flex items-center justify-center">
                <div class="text-center p-6">
                  <p class="text-gray-500 text-sm font-medium">スクリーンショットを配置</p>
                  <p class="text-gray-400 text-xs font-mono mt-2">public/screenshot-ai-chat.png</p>
                </div>
              </div>
            ) : (
              <!-- 組織管理・権限管理 リッチイラスト -->
              <div class="rounded-2xl border border-cyan-100 shadow-xl shadow-cyan-900/10 overflow-hidden bg-gradient-to-br from-slate-50 via-sky-50 to-cyan-50 p-6 select-none">

                <!-- Google ログインバナー -->
                <div class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-sm border border-gray-100 mb-6 w-fit mx-auto">
                  <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                  </svg>
                  <span class="text-sm font-medium text-gray-700">Google アカウントで即ログイン</span>
                  <span class="ml-1 bg-green-100 text-green-700 text-xs font-semibold px-2 py-0.5 rounded-full">SSO</span>
                </div>

                <!-- 組織ツリー -->
                <div class="flex flex-col items-center gap-0">

                  <!-- 組織ルート -->
                  <div class="bg-cyan-600 text-white text-xs font-bold px-5 py-2 rounded-full shadow-md shadow-cyan-300/50 tracking-wide flex items-center gap-2">
                    <i class="fa-solid fa-building text-cyan-200 text-[11px]"></i>
                    株式会社サンプル（組織）
                  </div>

                  <!-- 縦線 -->
                  <div class="w-px h-5 bg-cyan-300"></div>

                  <!-- 横線ブリッジ -->
                  <div class="flex items-start gap-16 relative">
                    <div class="absolute top-0 left-[calc(50%-32px)] right-[calc(50%-32px)] h-px bg-cyan-300" style="left:52px;right:52px;"></div>

                    <!-- 管理者カラム -->
                    <div class="flex flex-col items-center gap-0">
                      <div class="w-px h-5 bg-cyan-300"></div>
                      <div class="relative bg-white border-2 border-cyan-400 rounded-xl px-4 py-3 shadow-md shadow-cyan-200/60 flex flex-col items-center gap-1.5 min-w-[110px]">
                        <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-cyan-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap flex items-center gap-1">
                          <i class="fa-solid fa-shield-halved text-[9px]"></i> 管理者
                        </div>
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center mt-1">
                          <i class="fa-solid fa-user-tie text-white text-sm"></i>
                        </div>
                        <span class="text-xs font-semibold text-gray-800">田中 花子</span>
                        <div class="flex flex-col gap-1 w-full mt-1">
                          <div class="flex items-center gap-1 bg-cyan-50 rounded-md px-2 py-0.5">
                            <i class="fa-solid fa-check text-cyan-500 text-[9px]"></i>
                            <span class="text-[10px] text-cyan-700">社員登録・編集</span>
                          </div>
                          <div class="flex items-center gap-1 bg-cyan-50 rounded-md px-2 py-0.5">
                            <i class="fa-solid fa-check text-cyan-500 text-[9px]"></i>
                            <span class="text-[10px] text-cyan-700">申請承認・却下</span>
                          </div>
                          <div class="flex items-center gap-1 bg-cyan-50 rounded-md px-2 py-0.5">
                            <i class="fa-solid fa-check text-cyan-500 text-[9px]"></i>
                            <span class="text-[10px] text-cyan-700">組織設定変更</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- 一般社員カラム -->
                    <div class="flex flex-col items-center gap-0">
                      <div class="w-px h-5 bg-gray-300"></div>
                      <div class="relative bg-white border border-gray-200 rounded-xl px-4 py-3 shadow-sm flex flex-col items-center gap-1.5 min-w-[110px]">
                        <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-gray-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap flex items-center gap-1">
                          <i class="fa-solid fa-user text-[9px]"></i> 一般社員
                        </div>
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-gray-300 to-gray-400 flex items-center justify-center mt-1">
                          <i class="fa-solid fa-user text-white text-sm"></i>
                        </div>
                        <span class="text-xs font-semibold text-gray-800">鈴木 一郎</span>
                        <div class="flex flex-col gap-1 w-full mt-1">
                          <div class="flex items-center gap-1 bg-gray-50 rounded-md px-2 py-0.5">
                            <i class="fa-solid fa-check text-gray-400 text-[9px]"></i>
                            <span class="text-[10px] text-gray-600">プロフィール編集</span>
                          </div>
                          <div class="flex items-center gap-1 bg-gray-50 rounded-md px-2 py-0.5">
                            <i class="fa-solid fa-check text-gray-400 text-[9px]"></i>
                            <span class="text-[10px] text-gray-600">スキル・PJ申請</span>
                          </div>
                          <div class="flex items-center gap-1 bg-red-50 rounded-md px-2 py-0.5">
                            <i class="fa-solid fa-xmark text-red-400 text-[9px]"></i>
                            <span class="text-[10px] text-red-400">組織設定変更</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- データ分離バッジ -->
                <div class="mt-5 flex items-center justify-center gap-2 bg-white/80 border border-cyan-100 rounded-full px-4 py-2 w-fit mx-auto shadow-sm">
                  <i class="fa-solid fa-lock text-cyan-500 text-xs"></i>
                  <span class="text-xs text-gray-600 font-medium">組織ごとにデータを完全分離・セキュア管理</span>
                </div>

              </div>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .features-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, transparent 0 48%, rgb(34 211 238 / 0.12) 48% 58%, transparent 58% 100%),
      linear-gradient(180deg, rgb(255 255 255 / 0.4), transparent);
    pointer-events: none;
  }

  .feature-panel {
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .feature-panel:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 60px rgb(8 47 73 / 0.12);
  }

  .feature-window img {
    display: block;
  }
</style>
