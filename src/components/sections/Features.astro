---
const features = [
  {
    icon: '👤',
    title: 'プロフィール管理',
    description: '氏名・部署・職種・スキル・稼働状況・プロジェクト・資格・アバター画像など豊富な項目を管理。社員一覧はリスト/ギャラリー表示に切り替え可能。',
    imgSrc: '/screenshot-employee-list.png',
    alt: 'ひとナビ 社員一覧画面',
  },
  {
    icon: '📈',
    title: 'ダッシュボード・可視化',
    description: '在籍社員数・稼働状況のサマリー、ステータス内訳グラフ、部署別社員数グラフ、スキル別人数TOP10グラフで組織全体を一目で把握。',
    imgSrc: '/screenshot-dashboard.png',
    alt: 'ひとナビ ダッシュボード画面',
  },
  {
    icon: '🏢',
    title: '組織管理・権限管理',
    description: 'Googleログインで即座に利用開始。組織単位でデータを分離し、管理者と一般社員の権限を分けてセキュアに運用できます。',
    imgSrc: null,
    alt: null,
  },
  {
    icon: '📋',
    title: '申請管理',
    description: '社員が新しいスキルやプロジェクトを申請し、管理者が承認・却下。未処理の申請はヘッダーの通知ベルでリアルタイムに確認できます。',
    imgSrc: '/screenshot-requests.png',
    alt: 'ひとナビ 申請管理画面',
  },
  {
    icon: '🤖',
    title: 'AI人材検索',
    description: '全ページ共通のフローティングチャットUIから自然言語で質問。スキル検索、稼働状況確認、プロジェクトアサイン候補をAIが推薦します。',
    imgSrc: '/screenshot-ai-chat.png',
    alt: 'ひとナビ AIチャット画面',
  },
]
---

<section id="features" class="py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-16">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-wider mb-3">Features</p>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">主要機能</h2>
    </div>

    <div class="flex flex-col gap-16">
      {features.map((feature, i) => (
        <div class={`flex flex-col lg:flex-row gap-10 items-center ${i % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          <!-- テキスト -->
          <div class="flex-1">
            <div class="text-4xl mb-4">{feature.icon}</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
            <p class="text-gray-600 leading-relaxed text-lg">{feature.description}</p>
          </div>
          <!-- スクリーンショット -->
          <div class="flex-1 w-full">
            {feature.imgSrc ? (
              <div class="rounded-xl border border-gray-200 shadow-lg overflow-hidden">
                <img src={feature.imgSrc} alt={feature.alt ?? ''} class="w-full h-auto" />
              </div>
            ) : feature.title === 'AI人材検索' ? (
              <div class="rounded-xl border border-gray-200 shadow-lg overflow-hidden bg-gray-100 aspect-video flex items-center justify-center">
                <div class="text-center p-6">
                  <div class="text-3xl mb-3">🖼️</div>
                  <p class="text-gray-500 text-sm font-medium">スクリーンショットを配置</p>
                  <p class="text-gray-400 text-xs font-mono mt-2">public/screenshot-ai-chat.png</p>
                </div>
              </div>
            ) : (
              <div class="rounded-xl border border-dashed border-gray-300 bg-white aspect-video flex items-center justify-center">
                <div class="text-center p-6">
                  <div class="grid grid-cols-2 gap-3 mb-4 max-w-xs mx-auto">
                    <div class="bg-indigo-100 rounded-lg p-3 text-xs text-indigo-700 font-medium">管理者権限</div>
                    <div class="bg-gray-100 rounded-lg p-3 text-xs text-gray-600 font-medium">一般社員権限</div>
                    <div class="bg-green-50 rounded-lg p-3 text-xs text-green-700 font-medium">Googleログイン</div>
                    <div class="bg-blue-50 rounded-lg p-3 text-xs text-blue-700 font-medium">組織データ分離</div>
                  </div>
                  <p class="text-gray-400 text-xs">組織管理イメージ</p>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
