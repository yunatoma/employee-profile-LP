</section>

<style>
  .cta-section::before {
    content: "";
    position: absolute;
    inset: -35% -10% auto;
    height: 72%;
    transform: rotate(-6deg);
    background: repeating-linear-gradient(
      90deg,
      rgb(255 255 255 / 0.18) 0 20px,
      transparent 20px 42px
    );
    z-index: 0;
  }

  .cta-section::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background: linear-gradient(180deg, transparent, rgb(15 23 42 / 0.16));
    z-index: 0;
  }
</style>
