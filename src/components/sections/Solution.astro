---
const solutions = [
  {
    step: '01',
    title: '社員プロフィールを一元管理',
    description: '氏名・部署・職種・スキル・稼働状況・経歴・資格など、必要な情報をすべて1つのプラットフォームに集約します。',
  },
  {
    step: '02',
    title: 'スキル・部署・プロジェクトで絞り込み',
    description: 'キーワード検索、ステータスフィルタ、ツリー選択など多彩な検索手段で、必要な人材をすぐに見つけられます。',
  },
  {
    step: '03',
    title: '社員自身がプロフィールを更新',
    description: '一般社員が自分のプロフィールを直接編集できるため、管理者の手間を減らしながら情報の鮮度を保てます。',
  },
  {
    step: '04',
    title: '申請ワークフローで品質管理',
    description: 'スキルやプロジェクトの追加は申請→承認フローで管理。マスターデータの品質を組織として維持できます。',
  },
  {
    step: '05',
    title: 'AIチャットで自然言語検索',
    description: '「Reactが得意で今アサインできる人は？」のように質問するだけで、候補者とプロフィールリンクが返ってきます。',
  },
]
---

<section class="solution-section relative overflow-hidden py-24 bg-gradient-to-b from-white to-sky-50/80">
  <div class="relative z-10 max-w-6xl mx-auto px-6">

    <div class="mb-16 grid gap-8 lg:grid-cols-[0.86fr_1fr] lg:items-center">
      <div>
        <p class="text-cyan-600 font-semibold text-sm uppercase tracking-wider mb-3">Solution</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">
          ひとナビが解決します
        </h2>
        <p class="text-gray-600 mt-4 max-w-xl leading-relaxed">
          社員プロフィールとスキル情報を、探せる・更新できる・活用できるチーム資産にする。
        </p>
      </div>
      <div class="solution-summary rounded-2xl border border-sky-200/80 bg-gradient-to-br from-sky-50 via-white to-violet-50 p-5 shadow-xl shadow-sky-900/10 backdrop-blur-sm">
        <div class="grid grid-cols-3 gap-3 text-center text-sm font-semibold">
          <span class="rounded-lg bg-white px-3 py-3 text-sky-700 shadow-sm ring-1 ring-sky-100">集約</span>
          <span class="rounded-lg bg-white px-3 py-3 text-indigo-600 shadow-sm ring-1 ring-indigo-100">検索</span>
          <span class="rounded-lg bg-white px-3 py-3 text-rose-600 shadow-sm ring-1 ring-rose-100">活用</span>
        </div>
      </div>
    </div>

    <div class="solution-flow relative mx-auto max-w-4xl">
      {solutions.map((s) => (
        <div class="solution-step relative flex gap-5 rounded-xl border border-white/80 bg-white/75 p-5 shadow-sm shadow-cyan-900/5 backdrop-blur-sm">
          <div class="shrink-0 w-12 h-12 rounded-full bg-gradient-to-br from-sky-400 to-indigo-400 text-white flex items-center justify-center font-bold text-sm shadow-lg shadow-sky-500/15">
            {s.step}
          </div>
          <div class="pt-2">
            <h3 class="text-lg font-semibold text-gray-900 mb-1">{s.title}</h3>
            <p class="text-gray-600 leading-relaxed">{s.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .solution-section::before {
    content: "";
    position: absolute;
    left: -10%;
    right: -10%;
    top: 16%;
    height: 120px;
    transform: rotate(-3deg);
    background: repeating-linear-gradient(
      90deg,
      rgb(34 211 238 / 0.11) 0 22px,
      rgb(99 102 241 / 0.08) 22px 44px,
      transparent 44px 68px
    );
  }

  .solution-flow {
    display: grid;
    gap: 1.25rem;
  }

  .solution-summary {
    position: relative;
    box-shadow:
      0 18px 40px rgb(8 47 73 / 0.1),
      inset 0 1px 0 rgb(255 255 255 / 0.95);
  }

  .solution-summary::before {
    content: "";
    position: absolute;
    inset: -1px -1px auto;
    height: 5px;
    border-radius: 1rem 1rem 0 0;
    background: linear-gradient(90deg, #7dd3fc, #c4b5fd, #f9a8d4);
  }

  .solution-flow::before {
    content: "";
    position: absolute;
    /* p-5(1.25rem) + circle half-width(1.5rem) - line half-width(1px) */
    left: calc(1.25rem + 1.5rem - 1px);
    top: 1rem;
    bottom: 1rem;
    width: 2px;
    background: linear-gradient(180deg, #7dd3fc, #c4b5fd, #f9a8d4);
  }

  .solution-step {
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .solution-step:hover {
    transform: translateX(4px);
    box-shadow: 0 18px 42px rgb(8 47 73 / 0.1);
  }
</style>
