---
const cases = [
  {
    role: 'プロジェクトマネージャー',
    query: '「React経験者で今アサインできる人を探したい」',
    description: 'スキルフィルタと稼働状況で絞り込むか、AIチャットに質問するだけで候補者リストと各プロフィールリンクが返ってくる。',
    tags: ['スキル検索', 'AIチャット', '稼働確認'],
  },
  {
    role: '人事担当者',
    query: '「新入社員・異動者のプロフィールを整備したい」',
    description: '管理者が事前登録したメールアドレスでGoogleログインすると自動的に組織に参加。社員自身がプロフィールを入力・更新できる。',
    tags: ['組織管理', '社員登録', 'プロフィール更新'],
  },
  {
    role: '管理者',
    query: '「部署ごとの人数やスキル分布を把握したい」',
    description: 'ダッシュボードで部署別社員数グラフとスキル別人数TOP10グラフをすぐに確認。組織の状況を可視化して意思決定を支援する。',
    tags: ['ダッシュボード', '組織分析', '可視化'],
  },
  {
    role: '一般社員',
    query: '「新しいスキルやプロジェクトを追加したい」',
    description: '社員が申請→管理者が承認のフローでマスターデータに反映。承認結果は通知ベルでリアルタイムに確認できる。',
    tags: ['申請管理', 'スキル追加', 'ワークフロー'],
  },
]
---

<section id="usecases" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-16">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-wider mb-3">Use Cases</p>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">活用シナリオ</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {cases.map((c) => (
        <div class="bg-gray-50 rounded-xl p-8 border border-gray-200">
          <p class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-3">{c.role}</p>
          <p class="text-lg font-semibold text-gray-900 mb-4 leading-snug">{c.query}</p>
          <p class="text-gray-600 leading-relaxed mb-5">{c.description}</p>
          <div class="flex flex-wrap gap-2">
            {c.tags.map((tag) => (
              <span class="bg-indigo-50 text-indigo-700 text-xs font-medium px-3 py-1 rounded-full border border-indigo-100">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
