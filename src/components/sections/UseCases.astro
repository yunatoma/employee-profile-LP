---
const cases = [
  {
    icon: 'fa-diagram-project',
    role: 'プロジェクトマネージャー',
    query: '「React経験者で今アサインできる人を探したい」',
    description: 'スキルフィルタと稼働状況で絞り込むか、AIチャットに質問するだけで候補者リストと各プロフィールリンクが返ってくる。',
    tags: ['スキル検索', 'AIチャット', '稼働確認'],
  },
  {
    icon: 'fa-people-group',
    role: '人事担当者',
    query: '「新入社員・異動者のプロフィールを整備したい」',
    description: '管理者が事前登録したメールアドレスでGoogleログインすると自動的に組織に参加。社員自身がプロフィールを入力・更新できる。',
    tags: ['組織管理', '社員登録', 'プロフィール更新'],
  },
  {
    icon: 'fa-chart-pie',
    role: '管理者',
    query: '「部署ごとの人数やスキル分布を把握したい」',
    description: 'ダッシュボードで部署別社員数グラフとスキル別人数TOP10グラフをすぐに確認。組織の状況を可視化して意思決定を支援する。',
    tags: ['ダッシュボード', '組織分析', '可視化'],
  },
  {
    icon: 'fa-user-pen',
    role: '一般社員',
    query: '「新しいスキルやプロジェクトを追加したい」',
    description: '社員が申請→管理者が承認のフローでマスターデータに反映。承認結果は通知ベルでリアルタイムに確認できる。',
    tags: ['申請管理', 'スキル追加', 'ワークフロー'],
  },
]
---

<section id="usecases" class="usecases-section relative overflow-hidden py-24 bg-white">
  <div class="relative z-10 max-w-6xl mx-auto px-6">

    <div class="mb-16 grid gap-5 lg:grid-cols-[0.7fr_1fr] lg:items-end">
      <div>
        <p class="text-cyan-600 font-semibold text-sm uppercase tracking-wider mb-3">Use Cases</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">活用シナリオ</h2>
      </div>
      <p class="max-w-2xl text-slate-600 leading-relaxed lg:justify-self-end">
        役割ごとの「聞きたいこと」をチャット風に見せ、利用シーンがすぐ浮かぶようにしました。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {cases.map((c, i) => (
        <div class={`case-card relative overflow-hidden rounded-2xl border border-cyan-100 bg-white p-7 shadow-lg shadow-cyan-900/10 ${i === 1 || i === 2 ? 'md:translate-y-6' : ''}`}>
          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-50 text-cyan-600">
              <i class={`fa-solid ${c.icon}`}></i>
            </div>
            <p class="text-xs font-semibold text-cyan-600 uppercase tracking-wider">{c.role}</p>
          </div>
          <div class="relative mb-5 rounded-xl bg-slate-950 px-5 py-4 text-white shadow-lg shadow-slate-900/10">
            <span class="absolute -left-2 top-6 h-4 w-4 rotate-45 bg-slate-950"></span>
            <p class="text-lg font-semibold leading-snug">{c.query}</p>
          </div>
          <p class="text-gray-600 leading-relaxed mb-5">{c.description}</p>
          <div class="flex flex-wrap gap-2">
            {c.tags.map((tag) => (
              <span class="bg-white text-slate-700 text-xs font-medium px-3 py-1 rounded-full border border-cyan-100 shadow-sm">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .usecases-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(135deg, rgb(14 165 233 / 0.07) 0 1px, transparent 1px 18px),
      linear-gradient(180deg, #fff, rgb(240 249 255 / 0.7));
  }

  .case-card {
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .case-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 52px rgb(8 47 73 / 0.12);
  }

  @media (min-width: 768px) {
    .case-card.md\:translate-y-6:hover {
      transform: translateY(1rem);
    }
  }
</style>
