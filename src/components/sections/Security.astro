---
const securityItems = [
  {
    title: 'Googleログイン',
    description: 'OAuth2.0 / Firebase Authentication によるGoogleアカウント認証。パスワード管理不要で安全にログインできます。',
  },
  {
    title: '組織ごとのデータ分離',
    description: '組織IDベースのマルチテナント設計により、他組織のデータへのアクセスを構造的に遮断します。',
  },
  {
    title: '権限分離',
    description: '管理者と一般社員で操作範囲を明確に分離。社員は自分のプロフィールのみ、管理者は組織全体を管理できます。',
  },
  {
    title: '申請承認フロー',
    description: 'スキル・プロジェクトの追加は申請→承認の二段階。管理者が審査することでマスターデータの正確性を担保します。',
  },
]

const techStack = [
  { label: 'フロントエンド', items: ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS v4', 'Redux Toolkit'] },
  { label: 'バックエンド', items: ['Cloud Run', 'Express.js', 'Repository Pattern'] },
  { label: 'インフラ・DB', items: ['Firebase Authentication', 'Cloud Firestore', 'Firebase Storage'] },
  { label: 'AI・テスト', items: ['Gemini API', 'Recharts', 'Vitest', 'fast-check'] },
]
---

<section id="security" class="security-section relative overflow-hidden py-24 bg-gradient-to-br from-slate-50 via-white to-cyan-50 text-slate-900">
  <div class="relative z-10 max-w-6xl mx-auto px-6">

    <div class="mb-16 grid gap-8 lg:grid-cols-[0.86fr_1fr] lg:items-end">
      <div>
        <p class="text-cyan-600 font-semibold text-sm uppercase tracking-wider mb-3">Security & Architecture</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-slate-950">
          セキュアな設計と信頼できる技術構成
        </h2>
      </div>
      <div class="rounded-2xl border border-white bg-white/80 p-5 shadow-xl shadow-cyan-900/10">
        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="rounded-xl bg-cyan-50 p-3">
            <p class="text-xs font-semibold text-cyan-700">Auth</p>
          </div>
          <div class="rounded-xl bg-indigo-50 p-3">
            <p class="text-xs font-semibold text-indigo-700">Tenant</p>
          </div>
          <div class="rounded-xl bg-lime-50 p-3">
            <p class="text-xs font-semibold text-lime-700">Rules</p>
          </div>
        </div>
      </div>
    </div>

    <!-- セキュリティ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {securityItems.map((item) => (
        <div class="security-card bg-white/80 rounded-xl p-7 border border-white shadow-lg shadow-cyan-900/10 backdrop-blur-sm">
          <h3 class="text-lg font-semibold text-slate-950 mb-2">{item.title}</h3>
          <p class="text-slate-600 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>

    <!-- 技術スタック -->
    <div class="rounded-2xl border border-white bg-white/70 p-6 shadow-xl shadow-cyan-900/10 backdrop-blur-sm">
      <h3 class="text-center text-xl font-semibold text-slate-950 mb-10">技術スタック</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {techStack.map((group) => (
          <div class="rounded-xl bg-slate-50/80 p-4 ring-1 ring-cyan-100/70">
            <p class="text-xs font-semibold text-cyan-600 uppercase tracking-wider mb-3">{group.label}</p>
            <ul class="flex flex-col gap-2">
              {group.items.map((item) => (
                <li class="text-slate-700 text-sm bg-white rounded-lg px-4 py-2 border border-cyan-100 shadow-sm">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .security-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgb(15 23 42 / 0.05) 1px, transparent 1px),
      linear-gradient(rgb(15 23 42 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, transparent, #000 18%, #000 86%, transparent);
  }

  .security-card {
    position: relative;
  }

  .security-card::after {
    content: "";
    position: absolute;
    inset: auto 1.25rem -1px;
    height: 3px;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(90deg, #bae6fd, #c4b5fd, #bbf7d0);
  }
</style>
