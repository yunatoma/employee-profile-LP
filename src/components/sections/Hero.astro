---
---

<section class="hero-section relative isolate overflow-hidden pt-32 pb-20 bg-sky-50">
  <div class="hero-lines" aria-hidden="true">
    <span class="hero-line hero-line-1"></span>
    <span class="hero-line hero-line-2"></span>
    <span class="hero-line hero-line-3"></span>
  </div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(120deg,rgba(34,211,238,0.18)_0%,rgba(255,255,255,0.9)_38%,rgba(238,242,255,0.9)_100%)]"></div>
  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center gap-12">

      <!-- テキスト -->
      <div class="hero-copy flex-1 text-center lg:text-left rounded-2xl border border-white/80 bg-white/75 p-6 shadow-2xl shadow-cyan-900/10 backdrop-blur-xl lg:p-8">
        <div class="inline-block bg-cyan-100 text-cyan-800 text-xs font-semibold px-3 py-1 rounded-full mb-6 tracking-wide uppercase ring-1 ring-cyan-200">
          人材データ活用プラットフォーム
        </div>
        <h1 class="text-4xl lg:text-5xl font-bold text-slate-950 leading-tight mb-6">
          社員情報を、<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 via-indigo-600 to-pink-500">探せる人材データベース</span>へ。
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed mb-10 max-w-lg mx-auto lg:mx-0">
          プロフィール、スキル、稼働状況、プロジェクト情報を一元管理。<br />
          AIチャットでアサイン候補もすぐに見つかります。
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="https://employee-profile-app-184e1.web.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-cyan-500 text-white font-semibold px-8 py-4 rounded-lg hover:bg-cyan-600 transition-colors text-center shadow-lg shadow-cyan-500/25 flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-play text-sm"></i>デモを見る
          </a>
          <a
            href="https://github.com/yunatoma/employee-profile-app"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white text-slate-800 font-semibold px-8 py-4 rounded-lg border border-slate-200 hover:bg-slate-50 hover:border-cyan-300 transition-colors text-center flex items-center justify-center gap-2 shadow-sm"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            GitHubで見る
          </a>
        </div>
      </div>

      <!-- スクリーンショット -->
      <div class="flex-1 w-full max-w-2xl">
        <div class="hero-screen relative rounded-2xl border border-white shadow-2xl shadow-cyan-900/10 overflow-hidden bg-white">
          <img
            src="/screenshot-dashboard.png"
            alt="ひとナビ ダッシュボード画面"
            class="w-full h-auto"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-section::after {
    content: "";
    position: absolute;
    inset: auto -10% 0;
    height: 26%;
    z-index: -1;
    background: linear-gradient(180deg, rgb(255 255 255 / 0), #fff 74%);
    pointer-events: none;
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-line {
    position: absolute;
    display: block;
    height: 78px;
    width: min(880px, 112vw);
    border-radius: 999px;
    transform: translateX(-60%) translateY(120px) rotate(-24deg);
    transform-origin: left center;
    opacity: 0;
    filter: drop-shadow(0 24px 36px rgb(8 47 73 / 0.12));
    animation: diagonal-line-in 1100ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-line-1 {
    top: 16%;
    right: -18%;
    background: linear-gradient(90deg, rgb(34 211 238 / 0), rgb(34 211 238 / 0.24) 24%, rgb(99 102 241 / 0.25) 100%);
    animation-delay: 90ms;
  }

  .hero-line-2 {
    top: 42%;
    right: -10%;
    height: 112px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.7) 22%, rgb(244 114 182 / 0.22) 100%);
    animation-delay: 220ms;
  }

  .hero-line-3 {
    bottom: 10%;
    left: 4%;
    height: 42px;
    width: min(560px, 86vw);
    background: linear-gradient(90deg, rgb(103 232 249 / 0), rgb(103 232 249 / 0.24) 28%, rgb(163 230 53 / 0.28) 100%);
    animation-delay: 380ms;
  }

  .hero-screen::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.26), rgb(255 255 255 / 0) 34%);
    pointer-events: none;
  }

  .hero-screen {
    transform: perspective(1200px) rotateY(-5deg) rotateX(2deg);
  }

  @keyframes diagonal-line-in {
    0% {
      opacity: 0;
      transform: translateX(-60%) translateY(120px) rotate(-24deg) scaleX(0.88);
    }
    100% {
      opacity: 1;
      transform: translateX(0) translateY(0) rotate(-24deg) scaleX(1);
    }
  }

  @media (max-width: 1023px) {
    .hero-screen {
      transform: none;
    }

    .hero-line {
      height: 54px;
    }

    .hero-line-2 {
      height: 78px;
      top: 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line {
      animation: none;
      opacity: 1;
      transform: translateX(0) translateY(0) rotate(-24deg);
    }
  }
</style>
