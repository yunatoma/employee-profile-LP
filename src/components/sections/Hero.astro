---
---

<section class="pt-32 pb-20 bg-gradient-to-b from-indigo-50 to-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center gap-12">

      <!-- テキスト -->
      <div class="flex-1 text-center lg:text-left">
        <div class="inline-block bg-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1 rounded-full mb-6 tracking-wide uppercase">
          人材データ活用プラットフォーム
        </div>
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 leading-tight mb-6">
          社員情報を、<br />
          <span class="text-indigo-700">探せる人材データベース</span>へ。
        </h1>
        <p class="text-lg text-gray-600 leading-relaxed mb-10 max-w-lg mx-auto lg:mx-0">
          プロフィール、スキル、稼働状況、プロジェクト情報を一元管理。<br />
          AIチャットでアサイン候補もすぐに見つかります。
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="https://employee-profile-app-184e1.web.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-indigo-700 text-white font-semibold px-8 py-4 rounded-lg hover:bg-indigo-800 transition-colors text-center"
          >
            デモを見る
          </a>
          <a
            href="https://github.com/yunatoma/employee-profile-app"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white text-gray-700 font-semibold px-8 py-4 rounded-lg border border-gray-300 hover:border-indigo-400 hover:text-indigo-700 transition-colors text-center flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            GitHubで見る
          </a>
        </div>
      </div>

      <!-- スクリーンショット -->
      <div class="flex-1 w-full max-w-2xl">
        <div class="rounded-2xl border border-gray-200 shadow-2xl overflow-hidden">
          <img
            src="/screenshot-dashboard.png"
            alt="ひとナビ ダッシュボード画面"
            class="w-full h-auto"
          />
        </div>
      </div>

    </div>
  </div>
</section>
