---
const problems = [
  {
    icon: '📊',
    title: '社員情報が散らばっている',
    description: 'スプレッドシートや個人の記憶に情報がバラバラに存在し、どこに何があるか把握できない。',
  },
  {
    icon: '🔍',
    title: '誰が何を得意か探しづらい',
    description: 'スキル保有者を探そうとしても、一覧がなく各自に聞いて回るしかない。',
  },
  {
    icon: '🕐',
    title: 'プロフィールがすぐ古くなる',
    description: 'プロフィール更新が管理者任せになり、実態と乖離した情報が放置される。',
  },
  {
    icon: '⏳',
    title: 'アサイン検討に時間がかかる',
    description: '稼働状況やスキルを確認するために複数人に問い合わせが必要で、判断が遅れる。',
  },
]
---

<section class="py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-16">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-wider mb-3">Problem</p>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">
        こんな課題はありませんか？
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {problems.map((problem) => (
        <div class="bg-white rounded-xl p-8 border border-gray-200 flex gap-5 items-start">
          <div class="text-3xl shrink-0">{problem.icon}</div>
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{problem.title}</h3>
            <p class="text-gray-600 leading-relaxed">{problem.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
