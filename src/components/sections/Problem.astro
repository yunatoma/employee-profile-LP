---
const problems = [
  {
    icon: 'fa-table-cells',
    accent: 'from-cyan-400 to-sky-500',
    title: '社員情報が散らばっている',
    description: 'スプレッドシートや個人の記憶に情報がバラバラに存在し、どこに何があるか把握できない。',
  },
  {
    icon: 'fa-magnifying-glass',
    accent: 'from-indigo-400 to-cyan-500',
    title: '誰が何を得意か探しづらい',
    description: 'スキル保有者を探そうとしても、一覧がなく各自に聞いて回るしかない。',
  },
  {
    icon: 'fa-rotate',
    accent: 'from-pink-400 to-rose-500',
    title: 'プロフィールがすぐ古くなる',
    description: 'プロフィール更新が管理者任せになり、実態と乖離した情報が放置される。',
  },
  {
    icon: 'fa-hourglass-half',
    accent: 'from-lime-400 to-cyan-500',
    title: 'アサイン検討に時間がかかる',
    description: '稼働状況やスキルを確認するために複数人に問い合わせが必要で、判断が遅れる。',
  },
]
---

<section class="problem-section relative isolate overflow-hidden py-24 bg-white">
  <div class="relative z-10 max-w-6xl mx-auto px-6">

    <div class="mb-14 grid gap-6 lg:grid-cols-[1fr_0.74fr] lg:items-end">
      <div>
        <p class="text-cyan-600 font-semibold text-sm uppercase tracking-wider mb-3">Problem</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">
          こんな課題はありませんか？
        </h2>
      </div>
      <div class="rounded-xl border border-cyan-100 bg-white/80 p-5 shadow-sm shadow-cyan-900/5">
        <p class="text-sm font-semibold text-slate-900 mb-2">情報が散らばるほど、判断は遅くなる。</p>
        <p class="text-sm leading-relaxed text-slate-600">
          よくある詰まりを4つのカードに整理し、次のセクションで解決の流れにつなげます。
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {problems.map((problem, i) => (
        <div class={`problem-card relative overflow-hidden rounded-xl border border-cyan-100 bg-white p-7 shadow-lg shadow-cyan-900/10 ${i % 2 === 1 ? 'md:translate-y-8' : ''}`}>
          <div class={`absolute left-0 top-0 h-1.5 w-full bg-gradient-to-r ${problem.accent}`}></div>
          <div class="mb-5 flex items-center justify-between gap-4">
            <div class="shrink-0 w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-sm ring-1 ring-cyan-100">
            <i class={`fa-solid ${problem.icon} text-cyan-600 text-lg`}></i>
            </div>
            <span class="rounded-full bg-slate-50 px-3 py-1 text-xs font-bold tracking-wider text-slate-400">
              ISSUE {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{problem.title}</h3>
            <p class="text-gray-600 leading-relaxed">{problem.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .problem-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgb(14 165 233 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(14 165 233 / 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(180deg, transparent, #000 14%, #000 82%, transparent);
  }

  .problem-card {
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .problem-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 45px rgb(8 47 73 / 0.1);
  }

  @media (min-width: 768px) {
    .problem-card.md\:translate-y-8:hover {
      transform: translateY(1.5rem);
    }
  }
</style>
